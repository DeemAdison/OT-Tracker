# ==========================================
# Git Ignore Configuration for OT Tracker
# Multiplatform: Vue 3 + macOS + Windows + Android
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production Build Outputs (generated by npm run build)
dist/
dist-ssr/
*.local

# macOS Application Bundle Directory
# (App bundles contain platform-specific symlinks and signatures; use .pkg or .zip for distribution)
*.app/
.preview_thumbs/
.local/

# Temporary Scratch Directory
scratch/

# OS Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# Android Build & Gradle Cache
android-app/.gradle/
android-app/build/
android-app/app/build/
android-app/local.properties
android-app/.idea/
android-app/*.iml
android-app/app/*.iml
android-app/.cxx/
android-app/captures/
android-app/app/release/
android-app/app/debug/

# Tauri Build Artifacts
src-tauri/target/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables
.env
.env.local
.env.*.local
!.env.example
