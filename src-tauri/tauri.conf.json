{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OT Tracker",
  "version": "1.0.0",
  "identifier": "com.dip.ot-tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ระบบบันทึกและคำนวณเงิน OT (Personal OT Tracker)",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:ot_data.db"]
    }
  }
}
